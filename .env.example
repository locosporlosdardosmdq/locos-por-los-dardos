# ==========================================
# LOCOS POR LOS DARDOS • VARIABLES DE ENTORNO
# ==========================================

# 1. Base de Datos (Supabase PostgreSQL / Prisma)
# Reemplazá [PASSWORD] y [PROJECT-REF] con los datos de tu proyecto en Supabase
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# 2. URL Pública de la Aplicación
# En local: http://localhost:3000
# En producción: https://tu-dominio.vercel.app
NEXT_PUBLIC_APP_URL="https://tu-proyecto.vercel.app"

# 3. Mercado Pago (Checkout Pro en Pesos Argentinos - ARS)
# Obtenelo desde tu cuenta en mercadopago.com.ar/developers
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxxxxxxx-xxxxxx"
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="APP_USR-xxxxxxxxx-xxxxxx"
